# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # dari @BotFather
TELEGRAM_SECRET_TOKEN=      # string acak; dipakai saat setWebhook & divalidasi handler
TELEGRAM_ALLOWED_IDS=       # whitelist user id, pisah koma (mis. 12345678,98765432). KOSONG = izinkan semua!

# ── DeepSeek (struktur teks struk → JSON) ─────────────────────────────────
DEEPSEEK_API_KEY=          # dari platform.deepseek.com

# ── Google (Vision OCR + Sheets) ──────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT=    # service account JSON (1 baris) ATAU base64 dari JSON-nya
GOOGLE_SHEET_ID=           # ID dari URL spreadsheet
GOOGLE_SHEET_TAB=Sheet1    # nama tab (opsional, default Sheet1)
MONTHLY_BUDGET=9500000     # anggaran bulanan untuk gauge (opsional)

# ── Auth dashboard ────────────────────────────────────────────────────────
# Default 1 user. Hash dibuat via: bun scripts/hash-password.js '<password>'
AUTH_USERNAME=farel
AUTH_PASSWORD_HASH=        # hash argon2id (BUKAN password plain)
SESSION_SECRET=            # string acak >=32 byte untuk tanda-tangani cookie sesi
# Multi-user (opsional, override AUTH_USERNAME/HASH di atas):
# AUTH_USERS=[{"u":"farel","h":"$argon2id$..."},{"u":"budi","h":"$argon2id$..."}]
