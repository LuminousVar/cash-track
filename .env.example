# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_ALLOWED_IDS=        # your Telegram user ID, comma-separated. Leave empty to allow anyone

# DeepSeek
DEEPSEEK_API_KEY=

# Google
GOOGLE_SERVICE_ACCOUNT=      # contents of your service account JSON, single line
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# Budget
MONTHLY_BUDGET=9500000
BUDGET_WARN_PCT=80           # send a warning at this % of budget
BUDGET_NOTIFY_CHAT_ID=       # Telegram ID to receive budget alerts (defaults to first in ALLOWED_IDS)
CYCLE_START_DAY=1            # payday (1-28). 25 = budget period runs from the 25th to the 24th

# Auth
AUTH_USERNAME=
AUTH_PASSWORD_HASH=          # run: bun scripts/hash-password.js 'your-password'
SESSION_SECRET=              # random string, at least 32 characters
